APP_NAME=DoctFlow API
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api

# --- Banco ---
# Produção: Transaction Pooler do Supabase (porta 6543).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doctflow

# --- Supabase Auth ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- JWT da API ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- URLs ---
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000/dashboard
PUBLIC_BASE_URL=http://localhost:8000
# Rota do frontend que recebe o link do e-mail de recuperação de senha.
PASSWORD_RESET_PATH=/reset-password

# --- Agenda ---
TIMEZONE=America/Sao_Paulo
DEFAULT_CONSULTATION_DURATION_MINUTES=30
DEFAULT_ADVANCE_BOOKING_DAYS=30
DEFAULT_CANCELLATION_POLICY_HOURS=24

# --- WhatsApp ---
# console = modo mock (só loga). Outras opções: twilio | http_api
WHATSAPP_PROVIDER=console
# Usado pelo provider http_api e como segredo do webhook genérico
# (header X-Webhook-Secret). Vazio desliga o webhook genérico.
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Só desligue a validação de assinatura em teste local.
TWILIO_VALIDATE_SIGNATURE=true
# URL pública exata que a Twilio chama (necessária atrás de proxy/Railway).
TWILIO_WEBHOOK_URL=https://seu-host/api/webhooks/whatsapp/twilio

# --- Lembretes ---
# Scheduler interno. Desligue se usar cron externo ou mais de uma réplica.
REMINDERS_SCHEDULER_ENABLED=true
REMINDERS_INTERVAL_MINUTES=60
# Precisa ser >= REMINDERS_INTERVAL_MINUTES.
REMINDERS_WINDOW_MINUTES=75
# Segredo do POST /api/tasks/reminders/run (header X-Cron-Secret).
# Vazio mantém o endpoint desabilitado.
CRON_SECRET=

CORS_ORIGINS=http://localhost:3000
